{
  "manifest_version": 3,
  "name": "Context Tab Manager",
  "description": "Organize browser windows as persistent named contexts.",
  "version": "0.3.0",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Context Tab Manager",
    "default_popup": "manager/index.html"
  },
  "commands": {
    "focus-previous-context": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Focus the previously used context"
    },
    "open-quick-context-switcher": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Open the recent-context quick switcher"
    }
  }
}
