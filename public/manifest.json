{
  "manifest_version": 3,
  "name": "Context Tab Manager",
  "description": "Organize Chrome windows as persistent named contexts.",
  "version": "0.2.0",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Context Tab Manager",
    "default_popup": "manager/index.html"
  }
}
