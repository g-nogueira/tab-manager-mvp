{
  "name": "tab-manager-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:chrome",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "lint:firefox": "npx --yes web-ext@10.8.0 lint --source-dir dist-firefox"
  },
  "dependencies": {
    "svelte": "^5.38.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.0.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
